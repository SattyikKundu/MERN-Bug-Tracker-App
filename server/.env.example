# =========================================================
# Frontend URL
# =========================================================
# Frontend URL for local development or production.
CLIENT_HOME_URL=frontend_url


# =========================================================
# Backend Port
# =========================================================
# For example, MERN Bug Tracker can use port 5001 
PORT=backend_port


# =========================================================
# MongoDB Atlas Config
# =========================================================

# Replace USERNAME and PASSWORD with your actual Atlas DATABASE USER credentials.
# Do NOT use your MongoDB Atlas website-login credentials.
MONGO_URI=mongodb_uniform_resource_identifier

# Keep your existing application database name exactly the same.
MONGO_DB_NAME=mongo_database_name



# =================================================
# ENVIRONMENT VARIABLES - DO NOT SHARE PUBLICLY
# Used for authentication, sessions, and OAuth
# =================================================

# Use below command in cmd line terminal to get 64 byte random string for JWT and Session secret strings
# (NOTE: because 1 byte = 2 hex characters, the secret(s) have 128 characters each):
#
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# JWT secret for signing user tokens
JWT_SECRET=your_Super_Secret_JWT_Key

# Session secret for express-session (used by Passport Google OAuth)
SESSION_SECRET=another_Random_Secure_String


# =========================================================
# Google OAuth
# =========================================================

# Copy the REAL values from your local .env.
GOOGLE_CLIENT_ID=YOUR_REAL_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_REAL_GOOGLE_CLIENT_SECRET


# =========================================================
# Google OAuth callback URL
# =========================================================
# Local development example
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback